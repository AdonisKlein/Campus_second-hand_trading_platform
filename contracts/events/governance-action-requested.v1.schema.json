{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-market.example/contracts/events/governance-action-requested.v1.schema.json",
  "title": "GovernanceActionRequested v1",
  "type": "object",
  "required": ["eventId", "correlationId", "version", "occurredAt", "producer", "type", "reportId", "targetType", "targetId", "action", "adminId"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "version": {"const": 1},
    "occurredAt": {"type": "string"},
    "producer": {"const": "governance-service"},
    "type": {"const": "GovernanceActionRequested"},
    "reportId": {"type": "integer", "minimum": 1},
    "targetType": {"enum": ["ITEM", "MESSAGE", "USER"]},
    "targetId": {"type": "integer", "minimum": 1},
    "action": {"enum": ["REMOVE_ITEM", "REMOVE_MESSAGE", "DISABLE_USER"]},
    "adminId": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": true
}
