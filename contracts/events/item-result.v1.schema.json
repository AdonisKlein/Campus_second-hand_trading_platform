{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-market.example/contracts/events/item-result.v1.schema.json",
  "title": "Marketplace item result v1",
  "type": "object",
  "required": ["eventId", "correlationId", "version", "occurredAt", "producer", "type", "orderId", "itemId"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "version": {"const": 1},
    "occurredAt": {"type": "string"},
    "producer": {"const": "marketplace-service"},
    "type": {"enum": ["ItemReserved", "ItemReservationRejected", "ItemReleased", "ItemSold", "ItemCommandRejected"]},
    "orderId": {"type": "integer", "minimum": 1},
    "itemId": {"type": "integer", "minimum": 1},
    "reason": {"type": "string"}
  },
  "additionalProperties": true
}
