{
  "name": "campus-secondhand-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright end-to-end tests for the campus second-hand trading platform",
  "scripts": {
    "test:e2e": "playwright test",
    "e2e:up": "node scripts/compose-e2e.cjs up",
    "e2e:down": "node scripts/compose-e2e.cjs down",
    "e2e:wait": "node scripts/wait-for-e2e.cjs",
    "test:e2e:routing": "node scripts/check-compose-routing.cjs",
    "test:e2e:init-safety": "node scripts/check-mysql-init-safety.cjs",
    "test:e2e:traceability": "node scripts/check-uc-traceability.cjs",
    "test:e2e:runtime-traceability": "node scripts/check-uc-runtime-evidence.cjs",
    "test:e2e:compose": "node scripts/run-compose-e2e.cjs",
    "test:e2e:headed": "playwright test --headed",
    "report:e2e": "playwright show-report test-results/playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
