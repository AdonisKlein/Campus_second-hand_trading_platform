# Spring Boot reads these values from the process environment.
# Copy the names into your IDE run configuration or terminal; do not commit real secrets.
DB_URL=jdbc:mysql://localhost:3306/campus_secondhand?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change-me
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me

VERIFICATION_PEPPER=replace-with-a-long-random-production-secret
CORS_ALLOWED_ORIGINS=https://your-domain.example
SESSION_COOKIE_SECURE=true

UPLOAD_DIR=uploads
